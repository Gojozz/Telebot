# Paper trading only
TRADING_MODE=paper

# Starting virtual balance
INITIAL_BALANCE=1000

# Risk controls
RISK_PER_TRADE=0.005
MAX_DAILY_LOSS=0.02
MAX_OPEN_POSITIONS=2
MAX_CONSECUTIVE_LOSSES=3

# Strategy baseline
FAST_EMA=20
SLOW_EMA=50
MIN_RISK_REWARD=1.5
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.03

MAX_NOTIONAL_PCT=0.25

# Backtest assumptions only - not exchange-specific
FEE_RATE=0.001
SLIPPAGE_PCT=0.0005
